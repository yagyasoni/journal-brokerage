# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.

# Resend API key — https://resend.com/api-keys
# Server-side only: no NEXT_PUBLIC_ prefix, or the key ships to every visitor.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Who the notification is FROM. Must be an address on a domain verified in
# Resend (https://resend.com/domains) — a Gmail/Yahoo/Outlook address here
# fails DMARC and the mail gets filtered.
LEAD_FROM_EMAIL=Journal Brokerage <notifications@thejournalbrokerage.com>

# Where enquiries land.
LEAD_TO_EMAIL=journalbrokerage@gmail.com
