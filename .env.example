# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.
# This file is the committed template — keep the keys, never the values.

# ─── Lead notification email ──────────────────────────────────────────────────

# Resend API key — https://resend.com/api-keys
# Server-side only: no NEXT_PUBLIC_ prefix, or the key ships to every visitor.
RESEND_API_KEY=

# Who the notification is FROM. Must be an address on a domain verified in
# Resend (https://resend.com/domains) — a Gmail/Yahoo/Outlook address here
# fails DMARC and the mail gets filtered.
LEAD_FROM_EMAIL=

# Where enquiries land.
LEAD_TO_EMAIL=

# ─── Analytics & Search Console ───────────────────────────────────────────────
# Both are optional. Leave either blank and the corresponding tag is simply not
# rendered — nothing breaks, and no empty script tag reaches the page.

# GA4 measurement ID, e.g. G-XXXXXXXXXX. Public by design: it ships to the
# browser, which is why this one does carry the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_GA_ID=

# The token from Search Console's "HTML tag" verification method — the value of
# the content attribute only, not the whole <meta> tag.
# https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=
